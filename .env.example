# Copy this file to .env next to docker-compose.yml and fill in your own values. .env is not committed.
DB_PASSWORD=PUT_A_DATABASE_PASSWORD_HERE
JWT_SECRET=PUT_A_LONG_RANDOM_STRING_HERE
AUTOSCALE_MIN=2
AUTOSCALE_MAX=5

# Workers the load balancer always uses, comma separated. Add workers on other machines by their LAN address.
# RENDERERS=http://ray-worker-1:8080,http://ray-worker-2:8080,http://192.168.1.20:8080

# Only for docker-compose.worker.yml on a worker machine.
# WORKER_NAME=remote-worker
# WORKER_PORT=8080
# WORKER_CAPACITY=2
